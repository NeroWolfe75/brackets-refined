  // =====================================================
  // TEXTMATE TOKEN COLORS
  // =====================================================

  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6F7681",
        "fontStyle": "italic"
      }
    },

    {
      "name": "Keywords",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#C678DD"
      }
    },

    {
      "name": "Control Keywords",
      "scope": [
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.import",
        "keyword.control.return"
      ],
      "settings": {
        "foreground": "#C678DD"
      }
    },

    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.logical",
        "keyword.operator.comparison",
        "keyword.operator.arithmetic"
      ],
      "settings": {
        "foreground": "#56B6C2"
      }
    },

    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#98C379"
      }
    },

    {
      "name": "Escape Sequences",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#56B6C2"
      }
    },

    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#D19A66"
      }
    },

    {
      "name": "Booleans",
      "scope": ["constant.language.boolean"],
      "settings": {
        "foreground": "#D19A66"
      }
    },

    {
      "name": "Constants",
      "scope": ["constant.language", "constant.other"],
      "settings": {
        "foreground": "#D19A66"
      }
    },

    {
      "name": "Variables",
      "scope": ["variable"],
      "settings": {
        "foreground": "#E8E8E8"
      }
    },

    {
      "name": "This / Self",
      "scope": [
        "variable.language.this",
        "variable.language.this.ts",
        "variable.language.this.js",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },

    {
      "name": "Constants (TypeScript / JavaScript)",
      "scope": [
        "variable.other.constant",
        "variable.other.constant.ts",
        "variable.other.constant.js"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },

    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#D19A66"
      }
    },

    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#74B9FF"
      }
    },

    {
      "name": "Methods",
      "scope": [
        "entity.name.function.member",
        "support.function.method",
        "variable.function"
      ],
      "settings": {
        "foreground": "#74B9FF"
      }
    },

    {
      "name": "Classes",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#E5C07B"
      }
    },

    {
      "name": "Interfaces",
      "scope": ["entity.name.interface"],
      "settings": {
        "foreground": "#E5C07B"
      }
    },

    {
      "name": "Namespaces",
      "scope": ["entity.name.namespace"],
      "settings": {
        "foreground": "#56B6C2"
      }
    },

    {
      "name": "Types",
      "scope": ["support.type", "storage.type"],
      "settings": {
        "foreground": "#E5C07B"
      }
    },

    {
      "name": "Decorators",
      "scope": ["meta.decorator", "entity.name.function.decorator"],
      "settings": {
        "foreground": "#3FA9F5"
      }
    },

    {
      "name": "Regular Expressions",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#98C379"
      }
    },

    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Labels",
      "scope": ["entity.name.label"],
      "settings": {
        "foreground": "#E5C07B"
      }
    }
  ],

  // =====================================================
